[Unit]
Description=Radxa 3E recording button watcher
After=multi-user.target

[Service]
Type=simple
EnvironmentFile=/etc/default/radxa3e-record-button
ExecStart=/opt/radxa3e-groundstation/radxa3e-record-button.sh
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
