[Unit]
Description=Pi source mode agent controlled by Radxa mode button
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/home/pi/dji/pi-source-mode-agent.py --port 5513
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
