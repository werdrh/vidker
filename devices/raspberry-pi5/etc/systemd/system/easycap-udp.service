[Unit]
Description=EasyCAP low-latency UDP sender (Raspberry Pi 5)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/pi/dji
ExecStart=/home/pi/dji/pi-easycap-h264-rtp.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
